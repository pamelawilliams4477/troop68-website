body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 20px;
  background: #fff;
}

.hero {
  background: #b30000;
  color: white;
  padding: 60px 20px;
  text-align: center;
}

.btn {
  display: inline-block;
  margin-top: 15px;
  padding: 10px 18px;
  background: gold;
  color: black;
  text-decoration: none;
  border-radius: 5px;
}

h1, h2 {
  color: #b30000;
}

section {
  margin: 30px 0;
}
